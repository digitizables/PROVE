      "status": "proposed",
      "props": {
        "goal_id": "goal:hello",
        "worker": "playtest",
        "action": "verify_output",
        "summary": "Solo playtest requires the hello line and no hello failure.",
        "inputs": {
          "seconds": 3,
          "screenshot": false,
          "expect_contains": ["hello from the agent"],
          "expect_absent": ["hello failed"]
        },
        "done_when": "Evidence verdict is pass for output.contains.1.",
        "must_not": ["Edit any script.", "Save the place.", "Publish."],
        "after": "intent:read-hello",
        "order": 2
      }
