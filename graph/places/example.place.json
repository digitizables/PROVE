        "worker": "script",
        "action": "read_source",
        "summary": "Read HelloAgent and record its source hash.",
        "inputs": { "path": "game.ServerScriptService.HelloAgent" },
        "done_when": "script:hello status is observed and props.source_sha256 is set.",
