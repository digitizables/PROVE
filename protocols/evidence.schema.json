{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digitizables/PROVE/blob/main/protocols/evidence.schema.json",
  "title": "Evidence envelope",
  "description": "prove.evidence/1. Verdict rules are in docs/integration/roblox-studio-adapter.md. When studio is present it is roblox-studio-adapter.evidence/1 from that repo's docs/evidence.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "intent_id",
    "place_id",
    "worker",
    "captured_at",
    "verdict",
    "summary",
    "observations",
    "artifacts",
    "limits"
  ],
  "properties": {
    "schema": { "const": "prove.evidence/1" },
    "id": { "type": "string", "minLength": 1 },
    "intent_id": { "type": "string", "minLength": 1 },
    "place_id": { "type": "string", "minLength": 1 },
    "worker": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "minLength": 1 },
    "verdict": {
      "enum": ["pass", "fail", "inconclusive", "blocked"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limits": { "type": "string" },
    "studio": { "type": "object" }
  }
}
